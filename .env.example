# ==== Proveedores (al menos uno obligatorio) ====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==== Servicio ====
DEFAULT_PROVIDER=mock
DEFAULT_PROMPT_VERSION=v4
MAX_RETRIES=2
REQUEST_TIMEOUT_S=30

# ==== Caché de respuestas (MD5) ====
# El runner de evals nunca la usa: mediría la caché, no el modelo.
CACHE_ENABLED=true
CACHE_DIR=data/cache
CACHE_TTL_S=604800

# ==== Observabilidad ====
METRICS_PATH=data/metrics.jsonl
LOG_LEVEL=INFO